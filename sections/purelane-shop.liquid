{%- comment -%}
  purelane-shop.liquid
  --------------------
  The "#shop" section from purelane-homepage.html.

  Prototype markup this replaces:
    <section class="sec" id="shop" data-scene="3">
      ...eight hand-written <article class="glass card"> blocks

  Changes from the original, and why:

  1. All eight cards were hardcoded. Worse, they were hardcoded two
     different ways: cards 1-4 drew their bottle from a CSS custom
     property (--p-tap etc), cards 5-8 pasted a full inline <svg>.
     Same visual result, two mechanisms, neither editable. Both are
     replaced by one call to purelane-product-card, fed by a
     merchant-selected collection.

  2. The prototype's <h2> sat inside a .panel-head with no <h1> above
     it on the page. Heading level is a schema setting here so a
     merchant can place this section anywhere in the page's outline
     without breaking it.

  3. data-scene was hardcoded to 3. It is a setting now, because
     reordering sections in the theme editor should let a merchant fix
     the background progression themselves.

  4. Card CSS is loaded by this section rather than globally, so a page
     without a card-rendering section does not pay for it.
{%- endcomment -%}

{{ 'purelane-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<section
  class="sec purelane-shop"
  id="{{ section.settings.anchor_id | default: 'shop' | handle }}"
  data-purelane-section
  data-scene="{{ section.settings.scene }}"
  style="--sec-y-override: {{ section.settings.padding_block }}px;"
>
  <div class="wrap">
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="panel-head rv">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="d2" style="margin-top:12px">
            {{- section.settings.heading | escape -}}
          </{{ heading_tag }}>
        {%- endif -%}

        {%- if section.settings.show_rule -%}
          {%- comment -%}
            Decorative leaf divider. aria-hidden because it carries no
            meaning; the prototype left it exposed to screen readers.
          {%- endcomment -%}
          <div class="rule" aria-hidden="true">
            <i></i>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
            </svg>
            <i></i>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="shelf">
        {%- for product in collection.products limit: limit -%}
          {%- comment -%}
            reveal_delay cycles 1-4 rather than climbing forever, so the
            fifth card does not wait 45s to appear. Matches the
            prototype's .rv-d1 .. .rv-d4 usage per row.
          {%- endcomment -%}
          {%- assign delay = forloop.index0 | modulo: 4 -%}
          {% render 'purelane-product-card', product: product, reveal_delay: delay %}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all and collection.products_count > limit -%}
        <div class="shop__more rv rv-d2">
          <a class="btn btn-ghost" href="{{ collection.url }}">
            {{ section.settings.view_all_label | default: 'View all products' | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%}
        No collection chosen yet. In the theme editor an empty section
        looks broken and gives a merchant nothing to judge spacing
        against, so render placeholder cards at the real dimensions.
        Only inside the editor - a live storefront shows nothing.
      {%- endcomment -%}
      {%- if request.design_mode -%}
        <div class="shelf">
          {%- for i in (1..4) -%}
            <article class="glass card">
              <div class="shot">
                <span class="pimg-empty" aria-hidden="true">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </span>
              </div>
              <h3 class="card__title"><span class="card__title-text">
                {{ 'onboarding.product_title' | t: default: 'Example product' }}
              </span></h3>
              <div class="pr"><strong>{{ 19900 | money }}</strong></div>
            </article>
          {%- endfor -%}
        </div>
        <p class="body-s" style="text-align:center;margin-top:14px">
          Choose a collection in this section's settings to show real products.
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane — Shop grid",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 only if this is the first heading on the page.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "header",
      "content": "View all link"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"view all\" button",
      "info": "Appears only when the collection has more products than are shown.",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all products"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Background depth",
      "info": "1 is the shallowest and brightest, 4 the deepest. Sections should generally increase in depth down the page.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Used by in-page links, e.g. #shop.",
      "default": "shop"
    }
  ],
  "presets": [
    {
      "name": "Purelane — Shop grid"
    }
  ]
}
{% endschema %}
